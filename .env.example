# Şablon: .env olarak kopyalayıp doldurun (.env git'e girmez).
# Proje Docker'da çalışır; docker compose bu dosyayı otomatik okur (docker compose up -d --build).
# Postgres makinenizde çalışır; container ona host.docker.internal ile bağlanır.
#
# Prod'da aynı dosya sunucuda şu değerlerle doldurulur:
#   DEBUG=False
#   SECRET_KEY=<güçlü rastgele anahtar>
#   ALLOWED_HOSTS=api.cevirkazan360.com
#   CSRF_TRUSTED_ORIGINS=https://api.cevirkazan360.com,https://cevirkazan360.com
#   CORS_ALLOWED_ORIGINS=https://cevirkazan360.com   (prod'da ZORUNLU, yoksa tarayıcı istekleri engellenir)
#   DATABASE_URL=<prod veritabanı>
#   API_BASE_URL=https://api.cevirkazan360.com
#   BREVO_API_KEY / BREVO_SENDER_EMAIL=<mail gönderimi için>, MAIL_SUBJECT_PREFIX boş
DEBUG=True
SECRET_KEY=local-insecure-change-me
ALLOWED_HOSTS=localhost,127.0.0.1,host.docker.internal
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:8000
# Tarayıcıdan API'ye istek atabilen siteler (virgülle). Boşsa ve DEBUG=True ise hepsine izin verilir.
CORS_ALLOWED_ORIGINS=http://localhost:3000
DATABASE_URL=postgres://postgres:SIFRE@host.docker.internal:5432/wheel_db
API_BASE_URL=http://localhost:8000
# Maildeki randevu değerlendirme linki bu adresle başlar (prod: https://cevirkazan360.com)
FRONTEND_URL=http://localhost:3000

# Mail gönderimi local'de kapalı (anahtar boş)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=CevirKazan360
SUPPORT_EMAIL=
MAIL_SUBJECT_PREFIX=[LOCAL]
